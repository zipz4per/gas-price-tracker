# ---------------------------------------------------------------------------
# Template for .env.local — COMMITTED, so it must never contain real values.
#
# Copy to .env.local and fill in. .env.local is git-ignored; this file is the
# only environment file that belongs in version control.
#
# Local stack values come from `npx supabase start`.
# Hosted values come from the Supabase dashboard.
# ---------------------------------------------------------------------------

# --- Local stack (npx supabase start) --------------------------------------
# Printed by `npx supabase start` / `npx supabase status`. Not secret: these
# are the standard local development keys, identical on every local install.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_STUDIO_URL=

# --- Hosted project --------------------------------------------------------
# SUPABASE_HOSTED_SECRET_KEY is the service-role credential and bypasses
# Row-Level Security entirely. It must never appear in a migration, a seed
# file, or any committed file — this repository is public, and a key that
# reaches its history can only be remedied by rotating the key.
SUPABASE_HOSTED_PROJECT_REF=
SUPABASE_HOSTED_URL=
SUPABASE_HOSTED_PUBLISHABLE_KEY=
SUPABASE_HOSTED_SECRET_KEY=
SUPABASE_HOSTED_DB_PASSWORD=
